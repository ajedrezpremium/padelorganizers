# ============================================================
# PADELORGANIZERS.COM — Variables de entorno (MVP Gratuito)
# Copia este archivo como `.env` y rellena con los valores reales.
# En Vercel: Settings > Environment Variables.
# ============================================================

# --- Supabase (plan gratuito) ---
# Project Settings > API > Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Project Settings > API > anon / public key
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# --- Acceso API (opcional, para plugins/IA) ---
VITE_GEOCODE_KEY=

# --- Stripe (cobro real) ---
# Stripe Dashboard -> Developers > API keys. Prefijo sk_live_ (modo live) o sk_test_ (sandbox).
STRIPE_SECRET_KEY=

# --- PayPal (pruebas y pago alternativo) ---
# https://developer.paypal.com -> Dashboard -> Apps & Credentials -> REST API Apps
# Sandbox: usa credenciales de la app sandbox (MyApps) para pruebas (aplicador de dinero de prueba).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Campaña email (script clientes/enviar-campana.mjs) ---
# Gmail SMTP con App Password (16 dígitos, sin espacios). Generarla en:
# Google Account -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicación.
# Para pruebas de entregabilidad: usar Mailtrap (host smtp.mailtrap.io, puerto 587).
GMAIL_USER=
GMAIL_APP_PASS=

# --- Agente IA PadelCoach (OpenRouter) ---
# https://openrouter.ai -> API Keys. Obligatorio para activar PadelCoach AI.
OPENROUTER_API_KEY=sk-or-v1-TU-CLAVE
# (Opcional) Forzar un modelo concreto (p.ej. uno de pago). Si se deja vacío,
# el endpoint elige automáticamente un modelo :free del catálogo de OpenRouter
# (consulta /models, prioriza una lista curada y hace fallback si uno queda inactivo).
OPENROUTER_MODEL=